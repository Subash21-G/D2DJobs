@{
    ViewData["Title"] = "About Us | D2DJobs";

    ViewData["MetaDescription"] =
        "Learn more about D2DJobs and our mission to help students, freshers, and professionals find the latest job opportunities.";
}

<div class="container py-5 about-page">

    <div class="about-box">

        <h1>
            About D2DJobs
        </h1>

        <p class="about-intro">

            D2DJobs is a modern job information platform designed to help
            students, freshers, and professionals discover the latest career
            opportunities in one place.

        </p>

        <h3>
            Our Mission
        </h3>

        <p>

            Our mission is to simplify job searching by providing updated job listings,
            internships, work-from-home opportunities, IT jobs, core engineering jobs,
            government jobs, and career-related updates for job seekers across India.

        </p>

        <h3>
            What We Provide
        </h3>

        <ul class="about-list">

            <li>
                Latest Freshers Jobs
            </li>

            <li>
                IT & Software Jobs
            </li>

            <li>
                Internship Opportunities
            </li>

            <li>
                Work From Home Jobs
            </li>

            <li>
                Core Engineering Jobs
            </li>

            <li>
                Government Job Updates
            </li>

            <li>
                Career Guidance & Job Alerts
            </li>

        </ul>

        <h3>
            Why Choose D2DJobs?
        </h3>

        <p>

            We focus on providing a clean, user-friendly, and mobile-responsive
            platform where users can quickly discover trending job opportunities,
            save jobs, and apply directly through official company websites.

        </p>

        <p>

            D2DJobs is continuously improving to provide better career support,
            easier navigation, and faster access to opportunities for all job seekers.

        </p>

        <h3>How We Publish</h3>

        <p>
            We organize each listing into practical details such as eligibility, skills,
            location, selection steps, closing dates, and the application route. Listings
            that meet our publishing checks include an official source and a last-verified
            date. Read our <a href="/editorial-policy">editorial policy</a> to learn how
            listings are reviewed, corrected, and separated from paid promotion.
        </p>

        <div class="about-contact-box">

            <h4>
                Contact Information
            </h4>

            <p>
                Email:
                <a href="mailto:contactsupport21@gmail.com">
                    contactsupport21@gmail.com
                </a>
            </p>
            <p>
                Founder: Subash.G
            </p>

        </div>

    </div>

</div>
