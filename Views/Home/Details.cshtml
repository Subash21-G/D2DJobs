@inject Microsoft.Extensions.Options.IOptions<JobForFresher.Models.SiteOptions> SiteSettings
@model JobForFresher.Models.Job
@using System.Text.Json
@{
var related = ViewBag.RelatedJobs as List<Job> ?? new();
bool saved = ViewBag.IsSaved == true;
bool expired = ViewBag.IsExpired == true;
bool canApply = !expired && Uri.TryCreate(Model.ApplyLink, UriKind.Absolute, out var applyUri) && (applyUri.Scheme == "https" || applyUri.Scheme == "http");
string reportSubject = Uri.EscapeDataString("Report job listing: " + Model.Title);
string reportBody = Uri.EscapeDataString($"Listing: {Context.Request.Scheme}://{Context.Request.Host}/job/{Model.Slug}\n\nIssue (expired, incorrect details, broken link or other):\n\nDetails:");
// Use the same canonical job URL for sharing and structured data.
string pageUrl = SiteSettings.Value.SiteUrl.TrimEnd('/') + Url.RouteUrl("job-details", new { slug = Model.Slug });
string shareUrl = Uri.EscapeDataString(pageUrl);
var displayAddedAt = Model.ImportedUtc?.ToLocalTime() ?? Model.PostedDate;
var walkInStart = Model.WalkInStartDate ?? Model.WalkInDate;
var walkInEnd = Model.WalkInEndDate ?? (Model.WalkInStartDate.HasValue ? null : Model.WalkInDate);
var walkInRange = walkInStart.HasValue && walkInEnd.HasValue && walkInStart.Value.Date != walkInEnd.Value.Date
    ? $"{walkInStart.Value:dd MMM yyyy} to {walkInEnd.Value:dd MMM yyyy}"
    : (walkInStart ?? walkInEnd)?.ToString("dd MMM yyyy");
var schemaDescriptionParts = new[]
{
    Model.Description,
    $"Role: {Model.Role}",
    $"Company: {Model.CompanyName}",
    $"Location: {Model.Location}",
    $"Job type: {Model.JobType}",
    $"Experience: {Model.Experience}",
    $"Qualification: {Model.Qualification}",
    $"Salary: {Model.Salary}",
    $"Skills and requirements: {Model.Skills}",
    $"Eligibility: {Model.Eligibility}",
    $"Selection process: {Model.SelectionProcess}",
    $"Application instructions: {Model.ApplicationInstructions}",
    walkInStart.HasValue ? $"Walk-in start: {walkInStart.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}" : null,
    walkInEnd.HasValue ? $"Walk-in end: {walkInEnd.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}" : null,
    $"Documents to prepare: {Model.DocumentsRequired}"
}.Where(part => !string.IsNullOrWhiteSpace(part))
 .Select(part => System.Net.WebUtility.HtmlEncode(part!.Trim()));
string schemaDescription = string.Join("<br>", schemaDescriptionParts);
var shareLines = new List<string> { $"\U0001F680 {Model.Title}", "" };
foreach (var (label, value) in new[] {
    ("\U0001F3E2 Company", Model.CompanyName),
    ("\U0001F4BC Role", Model.Role),
    ("\U0001F393 Eligibility", Model.Qualification),
    ("\U0001F468\u200D\U0001F4BB Experience", Model.Experience),
    ("\U0001F4B0 Salary", Model.Salary),
    ("\U0001F4CD Location", Model.Location)
})
{
    if (!string.IsNullOrWhiteSpace(value)) shareLines.Add($"{label}: {value.Trim()}");
}
if (Model.WalkInStartDate.HasValue || Model.WalkInEndDate.HasValue) shareLines.Add($"\U0001F4C5 Walk-in: {Model.WalkInStartDate?.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? ""}{(Model.WalkInStartDate.HasValue && Model.WalkInEndDate.HasValue ? " to " : "")}{Model.WalkInEndDate?.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? ""}");
else if (Model.WalkInDate.HasValue) shareLines.Add($"\U0001F4C5 Walk-in: {Model.WalkInDate.Value.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)}");
if (Model.ExpiryDate.HasValue) shareLines.Add($"\U0001F4C5 Apply by: {Model.ExpiryDate.Value.ToString("dd MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture)}");
shareLines.Add("");
shareLines.Add($"\U0001F517 Apply here: {pageUrl}");
shareLines.Add("");
if (!string.IsNullOrWhiteSpace(SiteSettings.Value.WhatsAppUrl)) shareLines.Add($"\U0001F4F2 WhatsApp job group: {SiteSettings.Value.WhatsAppUrl}");
if (!string.IsNullOrWhiteSpace(SiteSettings.Value.TelegramUrl)) shareLines.Add($"\u2708\uFE0F Telegram job channel: {SiteSettings.Value.TelegramUrl}");
if (!string.IsNullOrWhiteSpace(SiteSettings.Value.WhatsAppUrl) || !string.IsNullOrWhiteSpace(SiteSettings.Value.TelegramUrl)) shareLines.Add("");
shareLines.Add("\U0001F4E2 Share with someone looking for a job!");string sharePlainText = string.Join(Environment.NewLine, shareLines);
string shareText = Uri.EscapeDataString(sharePlainText);
var sourceLinkLabel = Model.SourceType switch
{
    JobSourceTypes.OfficialEmployer => "View official employer posting",
    JobSourceTypes.GovernmentPortal => "View official recruitment notice",
    JobSourceTypes.JobPortal => "View source posting",
    _ => "View source"
};
var applyLinkLabel = Model.SourceType switch
{
    JobSourceTypes.OfficialEmployer => "Apply on company website",
    JobSourceTypes.GovernmentPortal => "Apply through official recruitment portal",
    JobSourceTypes.JobPortal => "Continue to application source",
    _ => "Apply Now"
};
var schema = new Dictionary<string, object?> {
    ["@context"] = "https://schema.org", ["@type"] = "JobPosting", ["title"] = Model.Title,
    ["description"] = schemaDescription,
    ["url"] = pageUrl,
    ["identifier"] = new Dictionary<string, object> { ["@type"] = "PropertyValue", ["name"] = Model.CompanyName, ["value"] = Model.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) },
    ["hiringOrganization"] = new Dictionary<string, object> { ["@type"] = "Organization", ["name"] = Model.CompanyName },
    ["jobLocation"] = new Dictionary<string, object> { ["@type"] = "Place", ["address"] = new Dictionary<string, object> { ["@type"] = "PostalAddress", ["addressLocality"] = Model.Location, ["addressCountry"] = "IN" } },
    ["educationRequirements"] = Model.Qualification,
    ["experienceRequirements"] = Model.Experience,
    ["skills"] = Model.Skills,
    ["directApply"] = false
};
if (Model.SourcePostedDate.HasValue) schema["datePosted"] = Model.SourcePostedDate.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
if (Model.ExpiryDate.HasValue) schema["validThrough"] = Model.ExpiryDate.Value.ToString("yyyy-MM-dd");
bool remote = Model.JobType.Contains("remote", StringComparison.OrdinalIgnoreCase) || Model.Category is "Work From Home Jobs" or "WFH Jobs";
if (remote)
{
    schema["jobLocationType"] = "TELECOMMUTE";
    schema["applicantLocationRequirements"] = new Dictionary<string, object> { ["@type"] = "Country", ["name"] = "India" };
}
var breadcrumbSchema = new Dictionary<string, object>
{
    ["@context"] = "https://schema.org",
    ["@type"] = "BreadcrumbList",
    ["itemListElement"] = new object[]
    {
        new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Jobs", ["item"] = SiteSettings.Value.SiteUrl.TrimEnd('/') + "/" },
        new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = Model.Category, ["item"] = SiteSettings.Value.SiteUrl.TrimEnd('/') + (JobCategories.Slug(Model.Category) is string categoryRoute ? "/jobs/" + categoryRoute : "/") },
        new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = Model.Title, ["item"] = pageUrl }
    }
};
}
<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a asp-route="category" asp-route-categorySlug="@JobCategories.Slug(Model.Category)">@Model.Category</a><span>/</span><span>@Model.CompanyName</span></nav>
@if (TempData["Notice"] is string notice) { <div class="notice" role="status">@notice</div> }
<div class="jobs-layout job-details-layout"><article class="detail-panel">
<div class="detail-company"><div class="company-avatar">@if (!string.IsNullOrEmpty(Model.CompanyLogo)) { <img src="~/uploads/logos/@Model.CompanyLogo" alt="@Model.CompanyName logo" /> } else { <span>@(string.IsNullOrWhiteSpace(Model.CompanyName) ? "D2D" : Model.CompanyName[..1].ToUpperInvariant())</span> }</div><span>@Model.CompanyName</span>@if (Model.IsFeatured) { <span class="featured-badge">Featured</span> }</div>
<h1><span aria-hidden="true">&#x1F680;</span> @Model.Title</h1><p class="detail-meta">@if(Model.SourcePostedDate.HasValue){<span>Posted @Model.SourcePostedDate.Value.ToString("dd MMM yyyy")</span>}else{<span>Added to D2DJobs @displayAddedAt.ToString("dd MMM yyyy")</span>} · @Model.Location</p>
@if (expired) { <div class="application-note"><strong>This opening has expired</strong>The closing date has passed or 30 days have elapsed since this job was posted. This page is retained only as a reference and is excluded from search indexing, feeds, category pages, and the sitemap.</div> }
<partial name="_JobDeadline" model="Model" />
<div class="apply-actions">
@if (!expired && !saved) { <form method="post" asp-action="SaveJob" asp-route-id="@Model.Id"><button class="secondary-button" type="submit"><i class="fa-regular fa-bookmark" aria-hidden="true"></i> Save job</button></form> }
@if (saved && !expired) { <a class="secondary-button" asp-action="SavedJobs">Saved to this browser</a> }
</div>
<h2 class="summary-heading">At a glance</h2>
<dl class="job-summary">
@foreach (var (icon, label, value) in new[] {
    ("\U0001F3E2", "Company", Model.CompanyName),
    ("\U0001F4BC", "Job Role", Model.Role),
    ("\U0001F393", "Qualification", Model.Qualification),
    ("\U0001F468\u200D\U0001F4BB", "Experience", Model.Experience),
    ("\U0001F4B0", "Salary/CTC", Model.Salary),
    ("\U0001F4CD", "Location", Model.Location),
    ("\U0001F4C2", "Category", Model.Category),
    ("\U0001F552", "Job Type", Model.JobType),
    ("\U0001F4C5", "Walk-in Dates", walkInRange),
    ("\U0001F4C5", "Apply by", Model.ExpiryDate?.ToString("dd MMMM yyyy"))
})
{
    if (!string.IsNullOrWhiteSpace(value))
    {
        <div class="job-summary-row"><dt><span aria-hidden="true">@icon</span> @label:</dt><dd>@value</dd></div>
    }
}
</dl>
@if (canApply)
{
    <p class="job-summary-apply"><a class="primary-button" href="#how-to-apply">View application details <span aria-hidden="true">&darr;</span></a></p>
}
@if (!string.IsNullOrWhiteSpace(Model.Description)) { <h2>About this opportunity</h2><div class="description-text">@Model.Description</div> }
@if (!string.IsNullOrWhiteSpace(Model.Skills)) { <h2>Skills & requirements</h2><div class="description-text">@Model.Skills</div> }
<partial name="Ads/_AdBox" model='"JobSidebar"' />
@if(Model.BatchFrom.HasValue && Model.BatchTo.HasValue){<h2>Eligible graduation batches</h2><p>@Model.BatchFrom – @Model.BatchTo</p>}
@if(!string.IsNullOrWhiteSpace(Model.Eligibility)){<h2>Eligibility</h2><div class="description-text">@Model.Eligibility</div>}
@if(!string.IsNullOrWhiteSpace(Model.SelectionProcess)){<h2>Selection process</h2><div class="description-text">@Model.SelectionProcess</div>}
@if(!string.IsNullOrWhiteSpace(Model.EditorialNote)){<h2>D2DJobs editorial guidance</h2><div class="description-text">@Model.EditorialNote</div>}
@if(!string.IsNullOrWhiteSpace(Model.DocumentsRequired)){<h2>Documents to prepare</h2><div class="description-text">@Model.DocumentsRequired</div>}
@{
    Func<DateTime?, string> showWalkIn = value =>
        !value.HasValue ? string.Empty :
        value.Value.ToString("dd MMM yyyy",
            System.Globalization.CultureInfo.InvariantCulture) +
        (value.Value.TimeOfDay == TimeSpan.Zero
            ? ""
            : value.Value.ToString(", hh:mm tt",
                System.Globalization.CultureInfo.InvariantCulture) + " IST");
}
@if (walkInStart.HasValue || walkInEnd.HasValue || !string.IsNullOrWhiteSpace(Model.WalkInVenue))
{
    <h2>Walk-in details</h2>

    @if (walkInStart.HasValue || walkInEnd.HasValue)
    {
        <p>
            @showWalkIn(walkInStart)
            @if (walkInEnd.HasValue &&
                (!walkInStart.HasValue || walkInEnd.Value != walkInStart.Value))
            {
                <span> – @showWalkIn(walkInEnd)</span>
            }
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(Model.WalkInVenue))
    {
        <div class="description-text">@Model.WalkInVenue</div>
    }
}
@if(Uri.TryCreate(Model.OfficialSourceUrl,UriKind.Absolute,out var sourceUri) && sourceUri.Scheme is "http" or "https"){<p><a href="@sourceUri.AbsoluteUri" target="_blank" rel="noopener noreferrer">@sourceLinkLabel &nearr;</a> <span class="muted">(@JobSourceTypes.Label(Model.SourceType))</span></p>}
<h2 id="how-to-apply">How to apply</h2>@if (canApply) { <div class="description-text">@Model.ApplicationInstructions</div> }
else if (expired) { <p class="muted">Applications are no longer accepted through this listing.</p> }
else { <p class="muted">An application link has not been added for this listing. Check the official source above for recruitment updates.</p> }
<div class="apply-actions">
@if (canApply) { <a class="primary-button" asp-action="ApplyClick" asp-route-id="@Model.Id" target="_blank" rel="noopener noreferrer">@applyLinkLabel &nearr;</a> }
else { <span class="application-unavailable">Application link unavailable</span> }
</div>
<div class="application-note"><strong>Apply safely</strong>Verify the opening on the employer's official website. Never pay a fee to secure a job.</div>
<div class="listing-report"><strong>Something incorrect?</strong><p>Let us know about an expired opening, broken application link or misleading details.</p><a href="mailto:contactsupport21@gmail.com?subject=@reportSubject&amp;body=@reportBody">Report this listing by email</a></div>
<h2>Share this opportunity</h2><p class="muted">Share a job summary with an Apply here link to this job details page.</p><div class="share-links"><a href="https://wa.me/?text=@shareText" target="_blank" rel="noopener noreferrer">WhatsApp</a><a href="https://t.me/share/url?url=@shareUrl&amp;text=@shareText" target="_blank" rel="noopener noreferrer">Telegram</a><a href="https://www.linkedin.com/sharing/share-offsite/?url=@shareUrl" target="_blank" rel="noopener noreferrer">LinkedIn</a>@if (!string.IsNullOrWhiteSpace(SiteSettings.Value.FacebookUrl)) { <a href="@SiteSettings.Value.FacebookUrl" target="_blank" rel="noopener noreferrer">Facebook</a> }@if (!string.IsNullOrWhiteSpace(SiteSettings.Value.InstagramUrl)) { <a href="@SiteSettings.Value.InstagramUrl" target="_blank" rel="noopener noreferrer">Instagram</a> }@if (!string.IsNullOrWhiteSpace(SiteSettings.Value.LinkedInUrl)) { <a href="@SiteSettings.Value.LinkedInUrl" target="_blank" rel="noopener noreferrer">Our LinkedIn</a> }<button class="secondary-button" type="button" data-copy-link data-copy-text="@sharePlainText">Copy share text</button><span id="copy-status" role="status"></span></div>
</article><aside class="jobs-sidebar"><section class="sidebar-panel"><div class="panel-heading"><h2>Similar opportunities</h2></div>@if (related.Count == 0) { <p class="muted">Explore all current openings to find your next opportunity.</p> }@foreach (var job in related) { <a class="compact-job" asp-action="Details" asp-route-slug="@job.Slug"><strong>@job.Title</strong><small>@job.CompanyName · @job.Location</small></a> }<a class="details-link" asp-route="category" asp-route-categorySlug="@JobCategories.Slug(Model.Category)">Browse @Model.Category &nearr;</a></section><section class="career-note"><span class="eyebrow">BEFORE YOU APPLY</span><h2>Make your application count.</h2><p>Highlight relevant projects, match your skills to the role and keep your contact details up to date.</p><a asp-action="SavedJobs">Your saved opportunities &nearr;</a></section></aside></div>
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(breadcrumbSchema))</script>
@if (!expired) { <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(schema))</script> }
<partial name="_CategoryPreparationGuide" model="CategoryPreparationGuides.ForJob(Model)" />






<section class="explore-panel" aria-labelledby="more-heading"><span class="eyebrow">YOUR NEXT OPPORTUNITY</span><h2 id="more-heading">Keep your options open</h2><p>Explore another role before choosing where to apply.</p>
<div class="related-grid">@foreach (var job in related.Take(3)) { <partial name="_JobCard" model="job" /> }</div>
<div class="explore-actions"><a class="primary-button" asp-route="category" asp-route-categorySlug="@JobCategories.Slug(Model.Category)">More @Model.Category &rarr;</a><a class="secondary-button" asp-action="Index" asp-route-location="@Model.Location">Jobs in @Model.Location</a><a class="secondary-button" asp-action="Index">Browse all opportunities</a></div></section>
