@model CommerceOverview
@{ ViewData["Title"] = "Employer & resume requests"; }
<link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
@if(TempData["Notice"] is string notice){<p class="tools-notice" role="status">@notice</p>}
<div class="admin-heading"><div><span class="eyebrow">EMPLOYERS &amp; RESUME SERVICES</span><h1>Review your incoming work.</h1><p class="muted">Confirm company details, application links, and agreed pricing before approval.</p></div></div>
<section class="admin-panel"><h2>Employer campaigns (@Model.Campaigns.Count)</h2>
@if(Model.Campaigns.Count == 0){<p class="muted">Employer submissions will appear here.</p>}
@foreach(var c in Model.Campaigns){<article class="tool-card campaign-card" data-campaign-id="@c.Id">
<div class="tools-heading"><div><span class="tool-badge">@c.DisplayStatus</span><h2>@c.Title</h2><p>@c.EmployerAccount.CompanyName · <a href="mailto:@c.EmployerAccount.Email">@c.EmployerAccount.Email</a></p></div><span>Featured: @c.UpgradeStatus</span></div>
<p>@c.Category · @c.Location · @c.Qualification · @c.Experience · @c.Salary</p><p>@c.StartDate.ToString("dd MMM yyyy") – @c.EndDate.ToString("dd MMM yyyy")</p>
<details><summary>Review submitted description and application link</summary><p class="preserve-lines">@c.Description</p><p><a href="@c.ApplyLink" target="_blank" rel="noopener noreferrer">@c.ApplyLink</a></p></details>
<form method="post" asp-action="Review" asp-route-id="@c.Id" class="tools-form"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(c.RowVersion)" /><label for="note-@c.Id">Review note (visible to employer)</label><textarea id="note-@c.Id" name="note" maxlength="1000" rows="2">@c.ReviewNote</textarea><div class="tool-actions"><button class="primary-button" name="decision" value="Approve" type="submit">Approve &amp; publish</button><button class="secondary-button" name="decision" value="Reject" type="submit">Reject</button><button class="secondary-button" name="decision" value="Pause" type="submit">Pause</button></div></form>
@if(c.UpgradeStatus is "Requested" or "Approved"){
<form method="post" asp-action="Upgrade" asp-route-id="@c.Id"><input type="hidden" name="rowVersion" value="@Convert.ToBase64String(c.RowVersion)" /><p>Activate featured placement only after agreeing the price and campaign dates with the employer.</p><div class="tool-actions">@if(c.UpgradeStatus == "Requested"){<button class="primary-button" name="decision" value="Approved" type="submit">Activate featured</button>}<button class="secondary-button" name="decision" value="Declined" type="submit">Decline / remove featured</button></div></form>}
<details><summary>Issue invoice</summary><p>Enter the agreed total and seller/billing details. An invoice is visible to the employer immediately after issue. Payment confirmation is manual.</p>
<form method="post" asp-action="Invoice" asp-route-id="@c.Id" class="tools-form"><div class="form-grid"><div><label for="number-@c.Id">Unique invoice number</label><input id="number-@c.Id" name="Number" required maxlength="80" /></div><div><label for="amount-@c.Id">Agreed total (INR)</label><input id="amount-@c.Id" name="Amount" type="number" min="1" max="9999999999.99" step="0.01" required /></div></div>
<label for="seller-@c.Id">Seller name, address and billing details</label><textarea id="seller-@c.Id" name="SellerDetails" required maxlength="500" rows="3"></textarea><label for="billto-@c.Id">Bill to</label><textarea id="billto-@c.Id" name="BillTo" required maxlength="500" rows="3">@c.EmployerAccount.CompanyName&#10;@c.EmployerAccount.Email</textarea><label for="description-@c.Id">Invoice description</label><input id="description-@c.Id" name="Description" value="Featured job placement" required maxlength="300" /><button class="primary-button" type="submit">Issue invoice</button></form></details>
@foreach(var invoice in c.Invoices.OrderByDescending(i => i.IssuedUtc)){<div class="tool-actions"><span>Invoice @invoice.Number · ₹@invoice.Amount.ToString("N2") · @(invoice.PaidUtc.HasValue ? "Paid" : "Unpaid")</span>@if(!invoice.PaidUtc.HasValue){<form method="post" asp-action="Paid" asp-route-id="@invoice.Id"><button class="secondary-button" type="submit">Confirm payment received</button></form>}</div>}
</article>}
</section>
<section class="admin-panel" style="margin-top:24px"><h2>Resume service requests (@Model.Requests.Count)</h2>
@if(Model.Requests.Count == 0){<p class="muted">New service enquiries will appear here.</p>}
@foreach(var request in Model.Requests){<article class="tool-card campaign-card"><span class="tool-badge">@request.Status</span><h3>@request.Service</h3><p>@request.Name · <a href="mailto:@request.Email">@request.Email</a> · @request.CreatedUtc.ToString("dd MMM yyyy HH:mm") UTC</p><p class="preserve-lines">@request.Notes</p><form method="post" asp-action="ResumeRequest" asp-route-id="@request.Id" class="tools-form"><label for="status-@request.Id">Request status</label><select id="status-@request.Id" name="status">@foreach(var status in new[]{"New","Contacted","In progress","Completed","Cancelled"}){<option selected="@(request.Status == status)">@status</option>}</select><button class="secondary-button" type="submit">Update request</button></form></article>}
</section>
