@model List<JobForFresher.Models.Job>
@{ ViewData["Title"]="Admin overview"; var top=ViewBag.TopViewedJobs as List<Job> ?? new(); }
@if(TempData["Notice"] is string notice){<p class="notice" role="status">@notice</p>}
<div class="admin-heading"><div><span class="eyebrow">WORKSPACE OVERVIEW</span><h1>Make your next post count.</h1><p class="muted">Manage your openings and keep opportunities up to date.</p></div><a class="primary-button" asp-action="Create">+ Create a job</a><a class="secondary-button" asp-action="Import">Import Excel</a></div>
<div class="admin-metrics">@foreach(var item in new[] {("Total jobs",(int)ViewBag.TotalJobs,""),("Active openings",(int)ViewBag.ActiveJobs,"Active"),("Expired listings",(int)ViewBag.ExpiredJobs,"Expired"),("Featured jobs",(int)ViewBag.FeaturedJobs,"")}) { <section class="admin-panel metric"><span>@item.Item1</span><strong>@item.Item2</strong>@if(item.Item3!="") { <a asp-action="Index" asp-route-status="@item.Item3">Review listings →</a> } else { <small class="muted">Across your job catalogue</small> }</section> }</div>
<section class="admin-panel"><div class="admin-heading"><div><h2>Job library</h2><p class="muted">@ViewBag.ResultCount matching listings</p></div><a asp-controller="Analytics" asp-action="Index">Traffic &amp; ad reports →</a></div>
<form method="get" class="admin-filters"><div class="admin-field"><label for="search">Search jobs</label><input id="search" name="search" value="@ViewBag.Search" placeholder="Title, company, location or skill" /></div><div class="admin-field"><label for="category">Category</label><select id="category" name="category"><option value="">All categories</option>@foreach(var category in JobCategories.All.Append("Company Wise Jobs")){<option selected="@(ViewBag.Category == category)">@category</option>}</select></div><div class="admin-field"><label for="status">Status</label><select id="status" name="status"><option value="">All statuses</option>@foreach(var status in new[]{"Active","Inactive","Expired","Needs review"}){<option selected="@(ViewBag.Status == status)">@status</option>}</select></div><div class="admin-field"><label for="recentDays">Recently added</label><select id="recentDays" name="recentDays"><option value="0" selected="@(ViewBag.RecentDays == 0)">Any time</option><option value="7" selected="@(ViewBag.RecentDays == 7)">Last 7 days</option><option value="30" selected="@(ViewBag.RecentDays == 30)">Last 30 days</option><option value="90" selected="@(ViewBag.RecentDays == 90)">Last 90 days</option></select></div><div class="admin-field"><label for="dateOrder">Date order</label><select id="dateOrder" name="dateOrder"><option value="newest" selected="@(ViewBag.DateOrder == "newest")">Newest first</option><option value="oldest" selected="@(ViewBag.DateOrder == "oldest")">Oldest first</option></select></div><div class="admin-field"><label for="addedFrom">Added from</label><input id="addedFrom" name="addedFrom" type="date" value="@ViewBag.AddedFrom" /></div><div class="admin-field"><label for="addedTo">Added to</label><input id="addedTo" name="addedTo" type="date" value="@ViewBag.AddedTo" /></div><button class="primary-button" type="submit">Filter</button><a class="secondary-button" asp-action="Index">Reset</a></form>
@if(ViewBag.InvalidDateRange == true){<p class="alert alert-danger" role="alert">The “Added from” date must be on or before the “Added to” date.</p>}
@if(Model.Count==0){<div class="empty-state"><h3>No matching jobs</h3><p>Create an opening or reset the filters to see your catalogue.</p><a asp-action="Create" class="primary-button">Create a job</a></div>}else{
<div class="table-responsive"><table class="admin-job-table"><thead><tr><th>Opportunity</th><th>Status</th><th>Performance</th><th>Posted</th><th>Manage</th></tr></thead><tbody>@foreach(var job in Model){var status=!job.IsActive?"Inactive":job.ExpiryDate<DateTime.Today?"Expired":"Active";<tr><td data-label="Opportunity"><strong>@job.Title</strong><small>@job.CompanyName · @job.Location</small><small>@job.Category @(job.IsFeatured ? " · Featured" : "")</small></td><td data-label="Status"><span class="status-badge status-@status.ToLowerInvariant()">@status</span></td><td data-label="Performance">@job.ViewsCount views<small>@job.ApplyClicks application clicks</small></td><td data-label="Posted">@job.PostedDate.ToString("dd MMM yyyy")</td><td data-label="Manage"><div class="admin-row-actions"><a class="secondary-button" asp-action="Edit" asp-route-id="@job.Id">Edit</a>@if(job.IsActive && !string.IsNullOrEmpty(job.Slug)){<a class="secondary-button" asp-controller="Home" asp-action="Details" asp-route-slug="@job.Slug">View</a>}<form method="post" asp-action="Delete" asp-route-id="@job.Id" data-confirm-delete><button class="danger-button" type="submit">Delete</button></form><partial name="_CopyShareText" model="job" /></div></td></tr>}</tbody></table></div>}
</section>
<div class="admin-bottom-grid"><section class="admin-panel"><h2>Most viewed opportunities</h2>@if(top.Count==0){<p class="muted">Your most viewed jobs will appear here.</p>}@foreach(var job in top){<a class="compact-job" asp-action="Edit" asp-route-id="@job.Id"><strong>@job.Title</strong><small>@job.CompanyName · @job.ViewsCount views · @job.ApplyClicks application clicks</small></a>}</section><section class="admin-panel admin-note"><span class="eyebrow">PUBLISHING CHECKLIST</span><h2>Keep your listings useful.</h2><p>Check official application links, review closing dates and include clear eligibility details.</p><a asp-action="Index" asp-route-status="Expired">Review expired jobs →</a><hr /><p>See daily traffic and record your AdSense report figures.</p><a asp-controller="Analytics" asp-action="Index">Open traffic &amp; ads →</a></section></div>@if(ViewBag.Pages > 1){<nav class="pagination-bar" aria-label="Admin job pages"><span>Page @ViewBag.Page of @ViewBag.Pages</span><div>@if(ViewBag.Page > 1){<a asp-action="Index" asp-route-page="@(ViewBag.Page-1)" asp-route-search="@ViewBag.Search" asp-route-category="@ViewBag.Category" asp-route-status="@ViewBag.Status" asp-route-recentDays="@ViewBag.RecentDays" asp-route-addedFrom="@ViewBag.AddedFrom" asp-route-addedTo="@ViewBag.AddedTo" asp-route-dateOrder="@ViewBag.DateOrder">Previous</a>}@if(ViewBag.Page < ViewBag.Pages){<a asp-action="Index" asp-route-page="@(ViewBag.Page+1)" asp-route-search="@ViewBag.Search" asp-route-category="@ViewBag.Category" asp-route-status="@ViewBag.Status" asp-route-recentDays="@ViewBag.RecentDays" asp-route-addedFrom="@ViewBag.AddedFrom" asp-route-addedTo="@ViewBag.AddedTo" asp-route-dateOrder="@ViewBag.DateOrder">Next</a>}</div></nav>}
