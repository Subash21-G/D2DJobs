@model ChangePasswordInput
@{ ViewData["Title"]="Account security"; }
<h1>Account security</h1><p class="muted">Use a unique password of at least 12 characters. Changing it signs out your other sessions.</p>
@if(TempData["Notice"] is string notice){<p class="notice" role="status">@notice</p>}
<form method="post" class="admin-panel" style="max-width:640px"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="admin-field"><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" autocomplete="current-password" /></div><div class="admin-field"><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" autocomplete="new-password" /></div><div class="admin-field"><label asp-for="ConfirmPassword">Confirm new password</label><input asp-for="ConfirmPassword" autocomplete="new-password" /></div><button type="submit" class="primary-button">Change password</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }