@model JobForFresher.Models.Job
@{ bool editing=ViewData["Editing"] is true; }
<form asp-action="@(editing ? "Edit" : "Create")" method="post" enctype="multipart/form-data" class="admin-editor">
<input type="hidden" asp-for="Id" /><div asp-validation-summary="All" class="validation-summary" role="alert"></div>
<div class="editor-grid"><div class="editor-main"><section class="admin-panel"><span class="eyebrow">01 / THE OPPORTUNITY</span><h2>Job &amp; company</h2><div class="field-grid">
<div class="admin-field full"><label asp-for="Title">Job title</label><input asp-for="Title" placeholder="Graduate Software Engineer" /><span asp-validation-for="Title"></span></div>
<div class="admin-field"><label asp-for="CompanyName">Company name</label><input asp-for="CompanyName" /></div><div class="admin-field"><label asp-for="Role">Role</label><input asp-for="Role" /></div>
<div class="admin-field"><label asp-for="Category">Category</label><select asp-for="Category"><option value="">Select a category</option>@foreach(var category in JobCategories.All.Append("Company Wise Jobs").Append(Model.Category).Where(c=>!string.IsNullOrEmpty(c)).Distinct()){<option>@category</option>}</select></div><div class="admin-field"><label asp-for="SubCategory">Subcategory</label><input asp-for="SubCategory" placeholder="e.g. Off Campus Drive" /></div>
<div class="admin-field"><label asp-for="Location">Location</label><input asp-for="Location" /></div><div class="admin-field"><label asp-for="JobType">Job type</label><input asp-for="JobType" placeholder="Full time, contract or remote" /></div></div></section>
<section class="admin-panel"><span class="eyebrow">02 / REQUIREMENTS</span><h2>Eligibility &amp; details</h2><div class="field-grid"><div class="admin-field"><label asp-for="Experience">Experience</label><input asp-for="Experience" /></div><div class="admin-field"><label asp-for="Salary">Salary</label><input asp-for="Salary" /></div><div class="admin-field full"><label asp-for="Qualification">Qualification</label><input asp-for="Qualification" /></div><div class="admin-field full"><label asp-for="Skills">Skills</label><textarea asp-for="Skills" rows="3"></textarea></div><div class="admin-field full"><label asp-for="Description">Job description</label><textarea asp-for="Description" rows="10"></textarea><small>Include responsibilities, eligibility, selection steps and how to apply.</small></div><div class="admin-field full"><label asp-for="ApplyLink">Application URL</label><input asp-for="ApplyLink" type="url" placeholder="https://careers.example.com/job" /><small>Use the official employer application page.</small></div></div></section><section class="admin-panel"><span class="eyebrow">CANDIDATE DETAILS</span><h2>Batch eligibility &amp; verification</h2><div class="field-grid">
<div class="admin-field"><label asp-for="BatchFrom">First eligible graduation year</label><input asp-for="BatchFrom" min="1990" max="2100" /></div><div class="admin-field"><label asp-for="BatchTo">Last eligible graduation year</label><input asp-for="BatchTo" min="1990" max="2100" /></div>
<div class="admin-field full"><label asp-for="Eligibility">Eligibility requirements</label><textarea asp-for="Eligibility" rows="3"></textarea></div><div class="admin-field full"><label asp-for="SelectionProcess">Selection process</label><textarea asp-for="SelectionProcess" rows="3"></textarea></div>
<div class="admin-field"><label asp-for="WalkInDate">Walk-in date &amp; time (India)</label><input asp-for="WalkInDate" type="datetime-local" /></div><div class="admin-field"><label asp-for="WalkInVenue">Walk-in venue</label><input asp-for="WalkInVenue" /></div>
<div class="admin-field full"><label asp-for="OfficialSourceUrl">Official source URL</label><input asp-for="OfficialSourceUrl" type="url" /></div><div class="admin-field"><label asp-for="LastVerifiedUtc">Last verified (UTC)</label><input asp-for="LastVerifiedUtc" type="datetime-local" /><small>Only set this after checking the employer's source.</small></div></div></section></div>
<aside class="admin-panel editor-settings"><span class="eyebrow">03 / PUBLISHING</span><h2>Listing settings</h2><div class="admin-field"><label for="logoFile">Company logo</label><input id="logoFile" name="logoFile" type="file" accept=".jpg,.jpeg,.png,.webp" data-logo-input /><small>JPG, JPEG, PNG or WEBP. Maximum 2 MB. Leave empty to keep the current logo.</small><img id="logoPreview" src="@(string.IsNullOrEmpty(Model.CompanyLogo) ? null : Url.Content("~/uploads/logos/"+Model.CompanyLogo))" hidden="@(string.IsNullOrEmpty(Model.CompanyLogo))" alt="Company logo preview" class="admin-logo-preview" /></div><div class="admin-field"><label asp-for="ExpiryDate">Closing date</label><input asp-for="ExpiryDate" type="date" /><small>Leave blank when the employer has not specified a date.</small></div><label class="admin-check"><input asp-for="IsActive" /> Active listing</label><label class="admin-check"><input asp-for="IsFeatured" /> Featured opportunity</label><div class="editor-actions"><button class="primary-button" type="submit">@(editing ? "Save changes" : "Save job")</button><a class="secondary-button" asp-action="Index">Cancel</a></div><small class="muted">Active jobs appear publicly until their closing date.</small></aside></div></form>