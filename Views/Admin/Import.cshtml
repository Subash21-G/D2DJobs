@model JobForFresher.Models.JobImportViewModel
@{ ViewData["Title"] = "Import jobs"; }
<div class="admin-heading"><div><span class="eyebrow">BULK IMPORT</span><h1>Import jobs from Excel</h1><p class="muted">Upload an .xlsx workbook and add all valid rows to your job library.</p></div><a class="secondary-button" asp-action="Index">Back to jobs</a></div>
<section class="admin-panel">
    <h2>Upload workbook</h2>
    <p>Use the first worksheet. The first row must contain <strong>Title</strong>. Other supported columns include CompanyName, Category, SourceType, SourcePostedDate (or PostedDate), SubCategory, Role, Location, Experience, Salary, JobType, Qualification, Skills, Description, ApplyLink, IsFeatured, ExpiryDate, BatchFrom, BatchTo, Eligibility, SelectionProcess, ApplicationInstructions, DocumentsRequired, EditorialNote, WalkInDate, WalkInStartDate, WalkInEndDate, WalkInVenue, OfficialSourceUrl and LastVerifiedUtc. Every valid imported row is activated automatically. Current, non-expired jobs appear on the homepage. Source dates are never inferred from the import date.</p>
    <p class="muted">Rows are validated before anything is saved. If a row fails validation, fix the workbook and upload it again.</p>
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <div class="admin-field"><label asp-for="File">Excel workbook (.xlsx)</label><input asp-for="File" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></div>
        @if (Model.Errors.Count > 0) { <div class="validation-summary" role="alert"><ul>@foreach (var error in Model.Errors) { <li>@error</li> }</ul></div> }
        <button class="primary-button" type="submit">Validate and import jobs</button>
    </form>
</section>
