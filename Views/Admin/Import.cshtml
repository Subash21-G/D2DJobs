@model JobForFresher.Models.JobImportViewModel
@{ ViewData["Title"] = "Import jobs"; }
<div class="admin-heading"><div><span class="eyebrow">BULK IMPORT</span><h1>Import jobs from Excel</h1><p class="muted">Upload an .xlsx workbook and add all valid rows to your job library.</p></div><a class="secondary-button" asp-action="Index">Back to jobs</a></div>
<section class="admin-panel">
    <h2>Upload workbook</h2>
    <p>Use the first worksheet. The first row must contain <strong>Title</strong>. Other supported columns include CompanyName, Category, SourceType, SourcePostedDate (or PostedDate), SubCategory, Role, Location, Experience, Salary, JobType, Qualification, Skills, Description, ApplyLink, IsFeatured, ExpiryDate, BatchFrom, BatchTo, Eligibility, SelectionProcess, ApplicationInstructions, DocumentsRequired, EditorialNote, WalkInDate, WalkInStartDate, WalkInEndDate, WalkInVenue and OfficialSourceUrl. When SourceType is blank, the importer detects it from the source URL domain. By uploading, you confirm that you checked each vacancy against its source. Imported rows are activated and stamped as checked at upload time; workbook status and verification dates are ignored.</p>
    <p class="muted">Malformed rows are rejected. Active, current listings appear publicly when they pass the site's automatic completeness, source URL, duplicate and expiry checks. Source posting dates are never inferred from the import date.</p>
    @if (!string.IsNullOrWhiteSpace(Model.Summary)) { <div class="notice" role="status"><strong>Import summary:</strong> @Model.Summary</div> }
    @if (Model.PublishedCount > 0) { <p class="application-note"><strong>Upload complete</strong>Imported rows are active. The public site automatically filters out listings that are expired, incomplete, duplicated or missing valid source and application details.</p><p><a class="secondary-button" asp-action="Index" asp-route-status="Active">View active listings</a></p> }
    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <div class="admin-field"><label asp-for="File">Excel workbook (.xlsx)</label><input asp-for="File" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></div>
        @if (Model.Errors.Count > 0) { <div class="validation-summary" role="alert"><strong>Rejected rows or workbook errors</strong><ul>@foreach (var error in Model.Errors) { <li>@error</li> }</ul></div> }
        <button class="primary-button" type="submit">Validate and import jobs</button>
    </form>
</section>
