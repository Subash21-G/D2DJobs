@model List<string>
@{ ViewData["Title"]="Private resumes"; }
<h1>Private resumes</h1><p class="muted">Legacy documents are stored outside the public website. Only signed-in administrators can download them.</p>
<section class="admin-panel">@if(Model.Count==0){<p>No private resumes found.</p>}@foreach(var name in Model){<a class="compact-job" asp-action="DownloadResume" asp-route-name="@name">@name</a>}</section>