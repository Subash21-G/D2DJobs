@model SiteSetupInput
@{ViewData["Title"]="Site setup";}
<h1>Site setup</h1><p class="muted">Configure your public domain, job-alert channels and approved advertising placements.</p>
@if(TempData["Notice"] is string notice){<p class="notice" role="status">@notice</p>}
<form method="post"><div asp-validation-summary="All" class="validation-summary" role="alert"></div><div class="admin-bottom-grid"><section class="admin-panel"><h2>Website &amp; job alerts</h2><div class="admin-field"><label asp-for="Site.SiteUrl">Public website URL</label><input asp-for="Site.SiteUrl" type="url" placeholder="https://jobs.example.com" /><small>Used for canonical links, feeds and the sitemap.</small></div><div class="admin-field"><label asp-for="Site.TelegramUrl">Telegram channel URL</label><input asp-for="Site.TelegramUrl" type="url" placeholder="https://t.me/yourchannel" /></div><div class="admin-field"><label asp-for="Site.WhatsAppUrl">WhatsApp channel or group URL</label><input asp-for="Site.WhatsAppUrl" type="url" /></div><div class="admin-field"><label asp-for="Site.FacebookUrl">Facebook page URL</label><input asp-for="Site.FacebookUrl" type="url" placeholder="https://facebook.com/yourpage" /></div><div class="admin-field"><label asp-for="Site.InstagramUrl">Instagram profile URL</label><input asp-for="Site.InstagramUrl" type="url" placeholder="https://instagram.com/yourprofile" /></div><div class="admin-field"><label asp-for="Site.LinkedInUrl">LinkedIn page URL</label><input asp-for="Site.LinkedInUrl" type="url" placeholder="https://linkedin.com/company/yourpage" /></div><p>RSS job alerts work without a third-party account. Channel links appear only after you configure them.</p><a asp-controller="Home" asp-action="Alerts">View job alerts →</a></section>
<section class="admin-panel"><h2>AdSense setup</h2><p class="muted">Use the IDs from your AdSense account. These controls do not request or verify Google approval, and do not install a consent platform.</p><div class="admin-field"><label asp-for="PublisherId">Publisher ID</label><input asp-for="PublisherId" placeholder="ca-pub-…" /></div><div class="admin-field"><label asp-for="ListingSlot">Listing ad slot ID</label><input asp-for="ListingSlot" inputmode="numeric" /></div><div class="admin-field"><label asp-for="DetailSlot">Job detail ad slot ID</label><input asp-for="DetailSlot" inputmode="numeric" /></div><label class="admin-check"><input asp-for="SiteApproved" /> I confirmed this site's approval in AdSense</label><label class="admin-check"><input asp-for="ConsentConfigured" /> Required privacy and consent setup is complete</label><label class="admin-check"><input asp-for="AdsEnabled" /> Enable configured ads</label><p class="muted">For audiences requiring consent, configure a Google-certified CMP before enabling ads. Keep ads separated from job actions and never request ad clicks.</p><a href="https://www.google.com/adsense/" target="_blank" rel="noopener noreferrer">Open AdSense ↗</a></section></div><button type="submit" class="primary-button mt-4">Save site setup</button></form>