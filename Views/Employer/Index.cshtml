@model List<EmployerCampaign>
@{ ViewData["Title"] = "Employer dashboard | D2DJobs"; var views = Model.Sum(c => (long)(c.Job?.ViewsCount ?? 0)); var clicks = Model.Sum(c => (long)(c.Job?.ApplyClicks ?? 0)); }
<div class="tools-heading"><div><span class="eyebrow">EMPLOYER WORKSPACE</span><h1>Your next hire starts here.</h1><p>@User.Identity?.Name · Manage openings and follow their performance.</p></div><a class="primary-button" asp-action="Create">+ Post a job</a></div>
<div class="tools-metrics"><section class="tool-card"><span>Campaigns</span><strong>@Model.Count</strong></section><section class="tool-card"><span>Job views</span><strong>@views.ToString("N0")</strong></section><section class="tool-card"><span>Apply clicks</span><strong>@clicks.ToString("N0")</strong></section><section class="tool-card"><span>Click-through rate</span><strong>@((views > 0 ? 100m * clicks / views : 0).ToString("0.0"))%</strong></section></div>
<div class="tools-heading"><div><h2>Your campaigns</h2><p class="muted">Lifetime listing metrics. Apply clicks count visits to your application link, not completed applications.</p></div></div>
@if(Model.Count == 0){<section class="tool-card empty-state"><h2>Make your first introduction.</h2><p>Tell candidates about your company and the role. We will review the opening before it goes live.</p><a class="primary-button" asp-action="Create">Post your first job</a></section>}
@foreach(var c in Model){<article class="tool-card campaign-card" data-campaign-id="@c.Id"><div class="tools-heading"><div><span class="tool-badge">@c.DisplayStatus</span><h2>@c.Title</h2><p>@c.Location · @c.Category</p></div><a class="secondary-button" asp-action="Edit" asp-route-id="@c.Id">Edit job</a></div>
<div class="campaign-facts"><div><span>Start / end</span><strong>@c.StartDate.ToString("dd MMM yyyy") – @c.EndDate.ToString("dd MMM yyyy")</strong></div><div><span>Views</span><strong>@(c.Job?.ViewsCount ?? 0)</strong></div><div><span>Apply clicks</span><strong>@(c.Job?.ApplyClicks ?? 0)</strong></div><div><span>CTR</span><strong>@c.Ctr.ToString("0.0")%</strong></div></div>
@if(!string.IsNullOrWhiteSpace(c.ReviewNote)){<p class="tools-notice">Review note: @c.ReviewNote</p>}
<div class="tool-actions">@if(c.DisplayStatus == "Live"){<a class="secondary-button" asp-controller="Home" asp-action="Details" asp-route-slug="@c.Job!.Slug">View listing</a>}
@if(c.UpgradeStatus is "None" or "Declined"){<form method="post" asp-action="Upgrade" asp-route-id="@c.Id"><button class="primary-button" type="submit">Request featured upgrade</button></form>}else{<span class="tool-badge">Featured: @c.UpgradeStatus</span>}
@foreach(var invoice in c.Invoices.OrderByDescending(i => i.IssuedUtc)){<a class="secondary-button" asp-action="Invoice" asp-route-id="@invoice.Id">Invoice @invoice.Number · @(invoice.PaidUtc.HasValue ? "Paid" : "Unpaid")</a>}
</div><p class="muted">Featured placement is optional. Pricing and dates are confirmed with you before activation. No payment is collected here.</p></article>}
