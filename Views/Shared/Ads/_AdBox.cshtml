@model string
@inject Microsoft.Extensions.Options.IOptions<JobForFresher.Models.AdvertisingOptions> AdSettings
@inject IWebHostEnvironment HostEnvironment
@{
    var ads = AdSettings.Value;
    var slot = ViewData["ShowAds"] is true && !HostEnvironment.IsDevelopment() ? ads.Slot(Model) : null;
}
@if (slot != null)
{
    <aside class="ad-placement" aria-label="Advertisement">
        <span class="ad-label">Advertisement</span>
        <ins class="adsbygoogle" style="display:block" data-ad-client="@ads.PublisherId" data-ad-slot="@slot" data-ad-format="auto" data-full-width-responsive="true"></ins>
        <script>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
    </aside>
}
