@inject Microsoft.Extensions.Options.IOptions<JobForFresher.Models.SiteOptions> SiteSettings
@{
    var title = ViewData["Title"] ?? "D2DJobs";
    var description = ViewData["MetaDescription"] ?? "Explore fresher jobs, off campus drives, walk-in interviews, government jobs and internships across India. Check eligibility and apply online.";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    bool noIndex = controller is "Admin" or "Analytics" or "Settings" || action is "SavedJobs" or "Error" || Context.Response.StatusCode >= 400 || Context.Request.Query.Count > 0;
    var configuredOrigin = Uri.TryCreate(SiteSettings.Value.SiteUrl, UriKind.Absolute, out var configuredUrl) && configuredUrl.Scheme == "https" ? configuredUrl.GetLeftPart(UriPartial.Authority) : $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}";
    var canonical = ViewData["Canonical"] as string ?? configuredOrigin + Context.Request.Path;
}
<title>@title</title>
<meta name="description" content="@description" />
<meta name="robots" content="@(noIndex ? "noindex, follow" : "index, follow")" />
<link rel="canonical" href="@canonical" />
<meta property="og:title" content="@title" />
<meta property="og:description" content="@description" />
<meta property="og:type" content="website" />
<meta property="og:url" content="@canonical" />
<meta property="og:site_name" content="D2DJobs" />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content="@title" />
<meta name="twitter:description" content="@description" />
