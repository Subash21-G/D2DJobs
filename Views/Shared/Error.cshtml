@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong | D2DJobs";
    ViewData["MetaDescription"] = "The requested D2DJobs page could not be completed.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Error</span></nav>
<section class="detail-panel">
    <span class="eyebrow">TEMPORARY PROBLEM</span>
    <h1>We could not complete that request.</h1>
    <p class="muted">Please try again. If the problem continues, contact support and include the reference below.</p>
    @if (Model.ShowRequestId)
    {
        <p><strong>Reference:</strong> <code>@Model.RequestId</code></p>
    }
    <div class="apply-actions">
        <a class="primary-button" href="/">Browse current jobs</a>
        <a class="secondary-button" asp-controller="Home" asp-action="Contact">Contact support</a>
    </div>
</section>
