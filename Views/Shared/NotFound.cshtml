@{
    ViewData["Title"] = "Page not found | D2DJobs";
    ViewData["MetaDescription"] = "The requested D2DJobs page could not be found.";
}

<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Page not found</span></nav>
<section class="detail-panel">
    <span class="eyebrow">404 / PAGE NOT FOUND</span>
    <h1>This opportunity or page is no longer available.</h1>
    <p class="muted">The address may be incorrect, or the listing may have closed. Explore current opportunities or contact us if a link needs attention.</p>
    <div class="apply-actions">
        <a class="primary-button" href="/">Browse current jobs</a>
        <a class="secondary-button" asp-controller="Home" asp-action="Contact">Report a broken link</a>
    </div>
</section>
