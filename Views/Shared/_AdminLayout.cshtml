@{ var action = ViewContext.RouteData.Values["action"]?.ToString(); var controller = ViewContext.RouteData.Values["controller"]?.ToString(); bool login = controller == "Admin" && action == "Login"; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><partial name="_SeoMeta" /><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" /></head>
<body class="admin-workspace"><a class="skip-link" href="#main-content">Skip to content</a>
<header class="admin-topbar"><a class="admin-brand" asp-controller="Admin" asp-action="Index"><span>D2D</span> D2DJobs <small>ADMIN</small></a><a asp-controller="Home" asp-action="Index">View website ↗</a></header>
@if (!login) { <nav class="admin-navigation" aria-label="Admin navigation"><a class="@(controller == "Admin" && action == "Index" ? "current" : "")" asp-controller="Admin" asp-action="Index">Overview &amp; jobs</a><a class="@(action == "Create" ? "current" : "")" asp-controller="Admin" asp-action="Create">Create job</a><a class="@(controller == "Analytics" ? "current" : "")" asp-controller="Analytics" asp-action="Index">Traffic &amp; ads</a><a asp-controller="Admin" asp-action="Security">Security</a><a asp-controller="Settings" asp-action="Index">Site setup</a><a asp-controller="Readiness" asp-action="Index">Launch readiness</a><form method="post" asp-controller="Admin" asp-action="Logout"><button type="submit" class="secondary-button">Sign out</button></form></nav> }
<main id="main-content" class="admin-content">@RenderBody()</main><footer class="admin-footer">D2DJobs · Administration</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/js/admin.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required:false)
</body></html>